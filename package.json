{
  "name": "menugard.ir",
  "version": "0.4.1",
  "private": false,
  "scripts": {
    "start": "node server.js",
    "lint": "eslint",
    "update": "npx npm-check-updates -u",
    "dev": "next dev --port 4501",
    "build": "npm run generate && next build",
    "db-build-push": "dotenv -e .env.production -- prisma db push",
    "db-build-migrate": "dotenv -e .env.production -- prisma migrate deploy",
    "db-build-reset": "dotenv -e .env.production -- prisma migrate reset",
    "db-build-generate": "npx prisma generate",
    "db-build-seed": "dotenv -e .env.production -- prisma db seed",
    "build-local": "dotenv -e .env.local -- prisma generate && next build",
    "db-local-push": "dotenv -e .env.local -- prisma db push",
    "db-local-generate": "dotenv -e .env.local -- prisma generate",
    "db-local-seed": "dotenv -e .env.local -- prisma db seed",
    "db-local-migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db-local-studio": "dotenv -e .env.local -- prisma studio"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.2",
    "@next/env": "16.2.4",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@prisma/extension-accelerate": "3.0.1",
    "@tailwindcss/postcss": "^4.2.4",
    "accept-language": "3.0.20",
    "animate.css": "^4.1.1",
    "bcryptjs": "3.0.3",
    "bootstrap-icons": "^1.13.1",
    "dompurify": "3.4.2",
    "dotenv": "17.4.2",
    "i18next": "26.0.8",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-resources-to-backend": "1.2.1",
    "next": "16.2.4",
    "next-auth": "5.0.0-beta.30",
    "nodemailer": "7.0.13",
    "pg": "8.20.0",
    "postcss": "^8.5.14",
    "qrcode": "1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-google-recaptcha-v3": "1.11.0",
    "react-hot-toast": "2.6.0",
    "react-i18next": "17.0.6",
    "react-number-format": "5.4.5",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "11.0.0",
    "eslint": "10",
    "eslint-config-next": "16.2.4",
    "prisma": "7.8.0",
    "tsx": "4.21.0"
  }
}
